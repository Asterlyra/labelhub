# 本地运行需要配置.env文件，docker运行无需配置
# Flask service
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# 大模型 Provider 类型。
# mock：本地模拟结果，不调用外部 API。
# openai：OpenAI 官方接口。
# openai_compatible：兼容 OpenAI Chat Completions 协议的常见厂商。
AI_AUDIT_PROVIDER=openai_compatible

# 是否强制使用本地 mock。开发和普通测试建议 true，真实联调改为 false。
AI_AUDIT_USE_MOCK=false

# 真实厂商 API 配置。mock 模式下可以留空。
# OpenAI 官方接口可不填 AI_AUDIT_BASE_URL。
# 火山方舟示例：https://ark.cn-beijing.volces.com/api/v3
# DeepSeek 示例：https://api.deepseek.com
AI_AUDIT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_AUDIT_API_KEY=
AI_AUDIT_MODEL=
AI_AUDIT_TEMPERATURE=0

AI_AUDIT_MEDIA_DOWNLOAD_TIMEOUT=10
AI_AUDIT_VIDEO_TIMEOUT=30
AI_AUDIT_MAX_VISUAL_EVIDENCE=6

# 本地测试
AGENT_API_BASE_URL=http://127.0.0.1:5001
AGENT_API_HEALTH_TIMEOUT=5
AGENT_API_TIMEOUT=120

# 默认关闭 RabbitMQ，方便本地继续只跑 HTTP demo。
AGENT_ENABLE_RABBITMQ_CONSUMER=true

# Agent MySQL
AGENT_MYSQL_HOST=127.0.0.1
AGENT_MYSQL_PORT=6033
AGENT_MYSQL_USER=root
AGENT_MYSQL_PASSWORD=
AGENT_MYSQL_DATABASE=labelhub_agent
AGENT_MYSQL_CHARSET=utf8mb4
AGENT_MYSQL_CONNECT_TIMEOUT=5
AGENT_MYSQL_POOL_SIZE=8
AGENT_MYSQL_POOL_TIMEOUT=5
AGENT_MYSQL_POOL_RECYCLE_SECONDS=1800

# 后端内部接口。
# RabbitMQ connection
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=2765
RABBITMQ_USERNAME=labelhub
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_AI_REVIEW_QUEUE=ai.review.queue
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_WORKER_CONCURRENCY=4
RABBITMQ_HEARTBEAT=60
RABBITMQ_BLOCKED_CONNECTION_TIMEOUT=30
RABBITMQ_REQUEUE_ON_FAILURE=true
RABBITMQ_MAX_RETRIES=3

LABELHUB_AGENT_TOKEN=
LABELHUB_MEDIA_ALLOWED_HOSTS=
