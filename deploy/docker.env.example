AI_AUDIT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

AI_AUDIT_API_KEY=

AI_AUDIT_MODEL=

# ==================== Host port mapping ====================
FRONTEND_PORT=80
BACKEND_PORT=8080
AGENT_PORT=5001
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==================== Middleware bootstrap ====================
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=labelhub
REDIS_PASSWORD=
RABBITMQ_USERNAME=labelhub
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
MINIO_ROOT_USER=labelhub
MINIO_ROOT_PASSWORD=
TZ=Asia/Shanghai

# ==================== Backend docker profile ====================
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/labelhub?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_DATABASE=0
SPRING_REDIS_PASSWORD=
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=labelhub
SPRING_RABBITMQ_PASSWORD=
SPRING_RABBITMQ_VHOST=/
LABELHUB_UPLOAD_PATH=/app/uploads
LABELHUB_MINIO_ENDPOINT=http://minio:9000
LABELHUB_MINIO_PUBLIC_URL=http://127.0.0.1:9000
LABELHUB_MINIO_ACCESS_KEY=labelhub
LABELHUB_MINIO_SECRET_KEY=
LABELHUB_AGENT_BASE_URL=http://agent-web:5001

# ==================== Frontend build ====================
VITE_API_BASE_URL=/api

# ==================== Agent image build ====================
AGENT_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
AGENT_PIP_EXTRA_INDEX_URL=
AGENT_PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
AGENT_PIP_DEFAULT_TIMEOUT=180
AGENT_PIP_RETRIES=15

# ==================== Agent runtime ====================
FLASK_PORT=5001
AI_AUDIT_PROVIDER=openai_compatible
AI_AUDIT_USE_MOCK=false
AI_AUDIT_TEMPERATURE=0
AI_AUDIT_MEDIA_DOWNLOAD_TIMEOUT=10
AI_AUDIT_VIDEO_TIMEOUT=30
AI_AUDIT_MAX_VISUAL_EVIDENCE=6
AGENT_MYSQL_HOST=mysql
AGENT_MYSQL_PORT=3306
AGENT_MYSQL_USER=root
AGENT_MYSQL_PASSWORD=
AGENT_MYSQL_DATABASE=labelhub_agent
AGENT_MYSQL_CHARSET=utf8mb4
AGENT_MYSQL_CONNECT_TIMEOUT=5
AGENT_MYSQL_POOL_SIZE=8
AGENT_MYSQL_POOL_TIMEOUT=5
AGENT_MYSQL_POOL_RECYCLE_SECONDS=1800
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=labelhub
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_AI_REVIEW_QUEUE=ai.review.queue
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_WORKER_CONCURRENCY=4
RABBITMQ_HEARTBEAT=60
RABBITMQ_BLOCKED_CONNECTION_TIMEOUT=30
RABBITMQ_REQUEUE_ON_FAILURE=true
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RECONNECT_BASE_DELAY_SECONDS=1
RABBITMQ_RECONNECT_MAX_DELAY_SECONDS=30
RABBITMQ_ERROR_LOG_INTERVAL_SECONDS=30

# Set the same random secret (at least 32 characters) for Backend and Agent.
LABELHUB_AGENT_TOKEN=
# Comma-separated trusted media hosts; empty disables remote media downloads.
LABELHUB_MEDIA_ALLOWED_HOSTS=
